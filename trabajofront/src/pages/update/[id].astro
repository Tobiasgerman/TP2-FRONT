---
export const prerender = false;

import Layout from "../../layouts/Layout.astro";
---

<Layout title="Editar comida">
  <section class="container">
    <a href="/" class="back-link">Volver al catalogo</a>

    <form id="editForm" class="edit-form">
      <h1>Editar comida</h1>

      <label for="title">Nombre</label>
      <input type="text" id="title" required />

      <label for="category">Categoria</label>
      <input type="text" id="category" />

      <label for="description">Descripcion</label>
      <textarea id="description"></textarea>

      <button type="submit">Guardar cambios</button>

      <p id="message"></p>
    </form>
  </section>
</Layout>

<script>
  import { supabase } from "../../lib/supabase";

  const urlParts = window.location.pathname.split("/");
  const id = urlParts[urlParts.length - 1];

  const form = document.getElementById("editForm");
  const titleInput = document.getElementById("title");
  const categoryInput = document.getElementById("category");
  const descriptionInput = document.getElementById("description");
  const message = document.getElementById("message");

  async function getUser() {
    const { data, error } = await supabase.auth.getUser();

    if (error || !data.user) {
      window.location.href = "/login";
      return null;
    }

    return data.user;
  }

  async function loadFood() {
    const user = await getUser();
    if (!user) return;

    if (!(message instanceof HTMLElement)) return;

    const { data, error } = await supabase
      .from("Comidas")
      .select("*")
      .eq("id", id)
      .eq("user_id", user.id)
      .single();

    if (error || !data) {
      message.textContent = "No se pudo cargar la comida.";
      return;
    }

    if (
      titleInput instanceof HTMLInputElement &&
      categoryInput instanceof HTMLInputElement &&
      descriptionInput instanceof HTMLTextAreaElement
    ) {
      titleInput.value = data.title || "";
      categoryInput.value = data.category || "";
      descriptionInput.value = data.description || "";
    }
  }

  if (
    form instanceof HTMLFormElement &&
    titleInput instanceof HTMLInputElement &&
    categoryInput instanceof HTMLInputElement &&
    descriptionInput instanceof HTMLTextAreaElement &&
    message instanceof HTMLElement
  ) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      const user = await getUser();
      if (!user) return;

      message.textContent = "Guardando cambios...";

      const { error } = await supabase
        .from("Comidas")
        .update({
          title: titleInput.value,
          category: categoryInput.value,
          description: descriptionInput.value,
        })
        .eq("id", id)
        .eq("user_id", user.id);

      if (error) {
        message.textContent = "Error: " + error.message;
        return;
      }

      message.textContent = "Comida actualizada correctamente.";

      setTimeout(() => {
        window.location.href = "/";
      }, 1000);
    });
  }

  loadFood();
</script>

<style>
  .container {
    max-width: 700px;
    margin: 0 auto;
    padding: 40px;
  }

  .back-link {
    color: #ea580c;
    font-weight: bold;
    text-decoration: none;
  }

  .edit-form {
    margin-top: 24px;
    background: white;
    padding: 32px;
    border-radius: 22px;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  h1 {
    color: #ea580c;
    margin: 0 0 10px;
  }

  label {
    font-weight: bold;
    color: #374151;
  }

  input,
  textarea {
    padding: 13px;
    border: 1px solid #d1d5db;
    border-radius: 12px;
    font-size: 15px;
    font-family: Arial, sans-serif;
  }

  textarea {
    min-height: 120px;
  }

  button {
    margin-top: 12px;
    border: none;
    background: #ea580c;
    color: white;
    padding: 13px;
    border-radius: 12px;
    font-weight: bold;
    cursor: pointer;
  }

  button:hover {
    background: #c2410c;
  }

  #message {
    color: #374151;
    font-weight: bold;
  }
</style>
